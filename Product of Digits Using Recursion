#include <stdio.h>

int productDigits(int n)
{
    if(n == 0)
        return 1;

    return (n % 10) * productDigits(n / 10);
}

int main()
{
    int n;

    printf("Enter a number: ");
    scanf("%d", &n);

    printf("Product = %d", productDigits(n));

    return 0;
}
