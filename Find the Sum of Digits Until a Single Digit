#include <stdio.h>

int sumDigits(int n)
{
    if(n == 0)
        return 0;

    return (n % 10) + sumDigits(n / 10);
}

int digitalRoot(int n)
{
    if(n < 10)
        return n;

    return digitalRoot(sumDigits(n));
}

int main()
{
    int n;

    printf("Enter Number: ");
    scanf("%d", &n);

    printf("Single Digit = %d", digitalRoot(n));

    return 0;
}
