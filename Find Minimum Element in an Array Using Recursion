#include <stdio.h>

int minimum(int arr[], int n)
{
    if(n == 1)
        return arr[0];

    int min = minimum(arr, n - 1);

    if(arr[n - 1] < min)
        return arr[n - 1];

    return min;
}

int main()
{
    int arr[] = {45, 12, 78, 5, 34};

    printf("Minimum = %d", minimum(arr, 5));

    return 0;
}
Sample Output
Minimum = 5
