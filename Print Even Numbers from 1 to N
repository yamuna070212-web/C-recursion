#include <stdio.h>

void even(int current, int n)
{
    if(current > n)
        return;

    if(current % 2 == 0)
        printf("%d ", current);

    even(current + 1, n);
}

int main()
{
    int n;

    printf("Enter N: ");
    scanf("%d", &n);

    even(1, n);

    return 0;
}
