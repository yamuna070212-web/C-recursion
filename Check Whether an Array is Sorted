#include <stdio.h>

int sorted(int arr[], int n)
{
    if(n == 1)
        return 1;

    if(arr[n - 1] < arr[n - 2])
        return 0;

    return sorted(arr, n - 1);
}

int main()
{
    int arr[] = {10,20,30,40,50};

    if(sorted(arr,5))
        printf("Sorted");
    else
        printf("Not Sorted");

    return 0;
}
