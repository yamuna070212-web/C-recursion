#include <stdio.h>

int lastOccurrence(int arr[], int index, int key)
{
    if(index < 0)
        return -1;

    if(arr[index] == key)
        return index;

    return lastOccurrence(arr, index - 1, key);
}

int main()
{
    int arr[] = {10,20,30,20,50};

    printf("%d", lastOccurrence(arr,4,20));

    return 0;
}
Sample Output
3
