#include <stdio.h>

void odd(int current, int n)
{
    if(current > n)
        return;

    if(current % 2 != 0)
        printf("%d ", current);

    odd(current + 1, n);
}

int main()
{
    int n;

    printf("Enter N: ");
    scanf("%d", &n);

    odd(1, n);

    return 0;
}
