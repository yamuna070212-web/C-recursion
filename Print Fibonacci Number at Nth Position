#include <stdio.h>

int fibonacci(int n)
{
    if(n == 0)
        return 0;
    if(n == 1)
        return 1;

    return fibonacci(n - 1) + fibonacci(n - 2);
}

int main()
{
    int n;

    printf("Enter Position: ");
    scanf("%d", &n);

    printf("Fibonacci Number = %d", fibonacci(n));

    return 0;
}
