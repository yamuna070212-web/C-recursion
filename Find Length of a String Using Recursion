#include <stdio.h>

int length(char str[], int i)
{
    if(str[i] == '\0')
        return 0;

    return 1 + length(str, i + 1);
}

int main()
{
    char str[100];

    printf("Enter String: ");
    scanf("%s", str);

    printf("Length = %d", length(str, 0));

    return 0;
}
