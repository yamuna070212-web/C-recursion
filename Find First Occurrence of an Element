#include <stdio.h>

int firstOccurrence(int arr[], int n, int key, int index)
{
    if(index == n)
        return -1;

    if(arr[index] == key)
        return index;

    return firstOccurrence(arr, n, key, index + 1);
}

int main()
{
    int arr[] = {10,20,30,20,50};

    printf("%d", firstOccurrence(arr,5,20,0));

    return 0;
}
