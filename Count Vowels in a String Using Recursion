#include <stdio.h>

int vowels(char str[], int i)
{
    if(str[i] == '\0')
        return 0;

    if(str[i]=='a'||str[i]=='e'||str[i]=='i'||str[i]=='o'||str[i]=='u'||
       str[i]=='A'||str[i]=='E'||str[i]=='I'||str[i]=='O'||str[i]=='U')
        return 1 + vowels(str, i + 1);

    return vowels(str, i + 1);
}

int main()
{
    char str[100];

    printf("Enter String: ");
    scanf("%s", str);

    printf("Vowels = %d", vowels(str, 0));

    return 0;
}
