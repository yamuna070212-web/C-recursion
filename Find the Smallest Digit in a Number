#include <stdio.h>

int smallestDigit(int n)
{
    if(n < 10)
        return n;

    int min = smallestDigit(n / 10);

    if(n % 10 < min)
        return n % 10;

    return min;
}

int main()
{
    int n;

    printf("Enter Number: ");
    scanf("%d", &n);

    printf("Smallest Digit = %d", smallestDigit(n));

    return 0;
}
